bin/
obj/
*.user
.vs/
# 发布产物（仓库根 publish/）；规则无前导斜杠，任意层级名为 publish 的目录都忽略
publish/
# 安装包产物（scripts/build-installer.ps1 输出：Setup.exe + RELEASES + nupkg）
dist/
# 精简版产物（-FrameworkDependent）
dist-lite/
publish-lite/
# 应用运行数据（便携版解压到仓库根时；Debug 的在 bin/ 下已被忽略）
/data/
# Gitee 发布令牌（scripts/publish-gitee.ps1 由人工读进 GITEE_TOKEN），绝不入库
.vpk-gitee-token
*.log

# 工具 / 助手元数据目录（不入库）
.workbuddy/
.workbuddy-ai/
.zcode/
